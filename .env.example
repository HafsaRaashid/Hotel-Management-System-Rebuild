APP_NAME="Hotel Management System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# SQ-003: cloud-hosted, single-tenant. No decision yet names the specific
# compute/runtime shape (SQ-011 is open) - this file only fixes the shape of
# configuration, not a hosting provider.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# SQ-002: retain the legacy database engine (MySQL/MariaDB). No domain table
# is created by this scaffold - see database/migrations/ - the connection
# mechanism is proven via the framework's own cache/jobs tables only.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hotel_management_system
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=log
